    "eb943b35-6685-4229-89ba-ea2a316b21e0": {
      "type": "nov-testimonials",
      "blocks": {
        "eb943b35-6685-4229-89ba-ea2a316b21e0-16791301172193a811-0": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Sleek Design & Smooth Performance",
            "quote": "<p>The suitcase looks incredibly premium and the wheels glide effortlessly. It made my business trip so much easier and stress-free.</p>"
          }
        },
        "eb943b35-6685-4229-89ba-ea2a316b21e0-16791301172193a811-1": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Lightweight Yet Durable",
            "quote": "<p>I was surprised by how light it is without sacrificing durability. It handled my trip perfectly and still looks brand new.</p>"
          }
        },
        "eb943b35-6685-4229-89ba-ea2a316b21e0-16791301172193a811-2": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Perfect for Organized Travel",
            "quote": "<p>The compartments are very well designed. Everything stayed organized throughout my trip, which I really appreciated.</p>"
          }
        },
        "02ba30b7-7798-40cf-9675-583c0670ead2": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Stylish and Practical",
            "quote": "<p>I’ve received so many compliments on this luggage. It’s not only stylish but also very functional for everyday travel.</p>"
          }
        },
        "1a9ca0a4-36fc-4172-8cf7-9632af689c04": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Great Quality and Fast Delivery",
            "quote": "<p>Shipping was quick and the quality exceeded my expectations. The suitcase feels solid and rolls smoothly on any surface.</p>"
          }
        },
        "1700f124-748c-4067-a4fd-8ce73b97560e": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Built for Every Journey",
            "quote": "<p>I’ve used this luggage on multiple trips already, and it performs perfectly every time. It’s reliable, smooth, and built to last.</p>"
          }
        },
        "ad18e750-8edf-4dd4-bc63-8734fbcf11e1": {
          "type": "quote",
          "settings": {
            "star": 5,
            "info_other": "Worth Every Penny",
            "quote": "<p>The quality and design feel far more expensive than the price. It’s a great investment for anyone who travels frequently.</p>"
          }
        }
      },
